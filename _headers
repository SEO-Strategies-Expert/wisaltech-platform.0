# Cloudflare Pages custom headers

# The CMS rewrites wisal-theme.css on every theme save, so it must never be
# held in a browser cache - otherwise colour/font changes stay invisible for
# hours. Pages only honours wildcard rules here, not exact file paths, so the
# whole (tiny) css folder revalidates; unchanged files still answer 304.
/static/css/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/web-Portfolio
  X-Robots-Tag: noindex, nofollow, noarchive
/web-Portfolio/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
