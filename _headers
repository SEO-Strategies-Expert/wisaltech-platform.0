# Cloudflare Pages custom headers
#
# Note: Pages ignores Cache-Control here for anything under /static, so the
# theme stylesheet is served through the worker at /api/theme instead.

/pay
  X-Robots-Tag: noindex, nofollow
/pay/*
  X-Robots-Tag: noindex, nofollow
/en/pay
  X-Robots-Tag: noindex, nofollow
/en/pay/*
  X-Robots-Tag: noindex, nofollow
/receipt
  X-Robots-Tag: noindex, nofollow
/receipt/*
  X-Robots-Tag: noindex, nofollow
/en/receipt
  X-Robots-Tag: noindex, nofollow
/en/receipt/*
  X-Robots-Tag: noindex, nofollow

/data/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/web-Portfolio
  X-Robots-Tag: noindex, nofollow, noarchive
/web-Portfolio/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
