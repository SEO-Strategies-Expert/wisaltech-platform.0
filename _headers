# Cloudflare Pages custom headers
#
# Note: Pages ignores Cache-Control here for anything under /static, so the
# theme stylesheet is served through the worker at /api/theme.css instead.

/data/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex

/web-Portfolio
  X-Robots-Tag: noindex, nofollow, noarchive
/web-Portfolio/*
  X-Robots-Tag: noindex, nofollow, noarchive

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  X-Frame-Options: DENY
