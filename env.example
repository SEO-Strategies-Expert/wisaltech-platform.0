# ===== إعدادات باك إند وصال تك =====
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية

PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=غيّر-هذا-السر-إلى-قيمة-عشوائية-طويلة

# ── البريد (تحقّق/استرجاع) — لو فاضي: الروابط تُطبع في الطرفية (وضع تطوير) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@wisaltech.qa

# ── تكاملات OAuth — سجّل تطبيقاتكم لدى المزوّدين واملأ المفاتيح ──
# Meta / WhatsApp / Instagram  (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
# Google Ads / Analytics  (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
